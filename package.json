{
  "name": "rexcvc",
  "version": "1.0.0",
  "private": true,
  "description": "Rexcvc frontend + backend + Android Capacitor",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:web": "node -e \"console.log('Rexcvc web build: static public/ directory')\"",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
